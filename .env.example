# Скопируйте этот файл в .env и при необходимости измените значения

# Секретный ключ Flask (сессии, CSRF). Для продакшена сгенерируйте свой:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zap4asti-dev-secret-key-please-change-in-production

# Путь к файлу базы данных SQLite (создаётся автоматически)
DATABASE=shop.db

# Учётные данные первого администратора.
# Если заданы и пользователь с таким email ещё не существует —
# администратор создаётся автоматически при старте приложения.
# ВНИМАНИЕ: смените пароль перед использованием вне локальной сети.
ADMIN_EMAIL=admin@zap4asti.store
ADMIN_PASSWORD=admin123

# Режим отладки Flask (True/False)
FLASK_DEBUG=True

# Порт, на котором запускается сервер
PORT=3000
