# Секреты и локальные настройки — никогда не коммитим
.env

# База данных — на каждом окружении (локально/на сервере) своя, со своими
# реальными товарами/заказами. В репозитории её быть не должно.
shop.db

# Загруженные через админку фото товаров — тоже разные на каждом окружении.
static/images/products/*
!static/images/products/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.test_venv/

# Временные файлы редакторов/ОС
*.swp
.DS_Store
